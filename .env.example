# Copy to .env and fill in. Never commit .env.

# --- LLM (required) ---
GROQ_API_KEY=
GROQ_FALLBACK_API_KEY=          # optional second key, used if the first fails
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_FAST_MODEL=openai/gpt-oss-20b

# --- Embeddings ---
GEMINI_API_KEY=
# EMBEDDING_PROVIDER=auto        # auto | gemini | local
# GEMINI_EMBEDDING_MODEL=models/gemini-embedding-2-preview
# LOCAL_EMBEDDING_MODEL=all-mpnet-base-v2

# --- Vector DB (required) ---
QDRANT_CLUSTER_ENDPOINT=
QDRANT_API_KEY=
# QDRANT_COLLECTION=enterprise_rag
# QDRANT_PATH=./qdrant_local         # embedded on-disk Qdrant instead of a server

# --- LLM gateway (optional; both needed to enable Portkey) ---
PORTKEY_API_KEY=
PORTKEY_CONFIG_ID=               # saved config slug, e.g. pc-xxxxxx
# GROQ_SLUG=rag

# --- Observability (optional) ---
LOGFIRE_TOKEN=
LANGSMITH_API_KEY=

# --- Agent ---
# MAX_TOOL_ROUNDS=4                  # tool-call rounds per question before forcing an answer

# --- Runtime ---
# CHECKPOINT_DB=checkpoints.sqlite   # ":memory:" for non-persistent memory
# BACKEND_URL=http://localhost:8000  # used by the Streamlit UI
